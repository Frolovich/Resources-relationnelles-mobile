# ==============================================
# (Re)Sources Relationnelles — Modèle de variables d'environnement
# ==============================================
# Copier ce fichier en .env sur chaque serveur (QA / préprod / prod)
# et renseigner les vraies valeurs. NE JAMAIS versionner le .env réel.
#
#   cp .env.example .env
# ==============================================

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ressource
MYSQL_USER=change_me_user
MYSQL_PASSWORD=change_me_password

# --- Backend Symfony ---
APP_SECRET=change_me_32_char_random_secret
JWT_PASSPHRASE=change_me_jwt_passphrase

# Regex des origines autorisées (CORS). Exemple pour la production :
CORS_ALLOW_ORIGIN=^https?://(www\.)?ressources-relationnelles\.fr$

# Image backend à déployer (tag précis en prod, ex : :1.4.2)
BACKEND_IMAGE=ghcr.io/frolovich/resources-relationnelles-mobile/backend:latest

# --- Mailer (SMTP) ---
MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_FROM=noreply@ressources-relationnelles.fr
