# ==============================================
# Modèle Jinja2 — génère le fichier .env sur le serveur
# ==============================================
# Les valeurs proviennent des variables Ansible (group_vars, --extra-vars,
# ou Ansible Vault pour les secrets). Ne jamais mettre de secret en clair ici.
# ==============================================

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database | default('ressource') }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}

# --- Backend Symfony ---
APP_SECRET={{ app_secret }}
JWT_PASSPHRASE={{ jwt_passphrase }}
CORS_ALLOW_ORIGIN={{ cors_allow_origin }}
BACKEND_IMAGE={{ backend_image | default('ghcr.io/frolovich/resources-relationnelles-mobile/backend:latest') }}

# --- Mailer (SMTP) ---
MAILER_DSN={{ mailer_dsn }}
MAILER_FROM={{ mailer_from }}
